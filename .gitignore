# ============================================================
# FACILITO — .gitignore (raíz del monorepo)
# ============================================================

# ========================
# Dependencies (543MB + 679MB, se reinstalan con pnpm install)
# ========================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ========================
# Build / Output (573MB + 4.7MB, se regeneran con los rebuild)
# ========================
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ========================
# Environment / Secrets (CRÍTICO — JWT_SECRET, DB password, etc.)
# ========================
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ========================
# Base de datos / Logs
# ========================
*.sql
*.sqlite
*.db
*.log
logs/
backend.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# Uploads (25MB de archivos de usuarios, NO van a Git)
# ========================
apps/backend/public/uploads/
apps/backend/uploads/
apps/frontend/public/uploads/

# ========================
# Backups locales
# ========================
*.bak
*.bak-*
*.backup-*
*.old
*.orig
backups/
.backups-faseK/

# ========================
# Binarios
# ========================
cloudflared
*.exe
*.bin

# ========================
# Sistema operativo
# ========================
.DS_Store
Thumbs.db

# ========================
# IDE
# ========================
.vscode/
.idea/
*.swp
*.swo

# ========================
# Vercel
# ========================
.vercel

# ========================
# Archivos raros (como el archivo "-d" que vi en backend)
# ========================
-d
